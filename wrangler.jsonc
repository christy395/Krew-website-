{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "krew-dashboard",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-17",
  "upload_source_maps": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}